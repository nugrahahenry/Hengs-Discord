# ════════════════════════════════════════════════════════
#  Hengs Discord Bot (Henzzz) — contoh konfigurasi
#  Copy file ini jadi `.env`, lalu isi value-nya.
#  JANGAN PERNAH commit file .env asli ke Git!
# ════════════════════════════════════════════════════════

# ── Bot credentials (Discord Developer Portal) ──
# Bot -> Reset Token. JANGAN share; regenerate kalau bocor.
DISCORD_TOKEN=
# General Information -> Application ID
DISCORD_CLIENT_ID=
# Aktifkan Developer Mode -> klik-kanan server -> Copy Server ID
DISCORD_GUILD_ID=
# Maksimal server publik aktif. Rentang aman 1 sampai 100, default 25.
HENGS_PUBLIC_GUILD_LIMIT=25
# Opsional: folder konfigurasi terisolasi per server. Default: data/guilds/.
HENGS_GUILD_CONFIG_DIR=
# User ID owner Discord. Wajib untuk approval Ops Hub dan /admin restart.
OWNER_ID=
# Role Discord yang boleh membuat, melihat, mengedit, dan merevisi draft Ops Hub/Event Hub.
# Pisahkan beberapa role ID dengan koma. Publish/jadwal/discard/cancel tetap owner-only.
OPS_EDITOR_ROLE_IDS=

# ── Channel IDs (klik-kanan channel -> Copy Channel ID) ──
ANNOUNCE_CHANNEL_ID=
WELCOME_CHANNEL_ID=
GSA_CHANNEL_ID=
BOT_CHANNEL_ID=
# Ops Hub review channel privat. Sangat disarankan; fallback hanya ke nama persis
# `🎛️・bot-settings` / `bot-settings`, tidak pernah ke BOT_CHANNEL_ID.
BOT_SETTINGS_CHANNEL_ID=
# Report Hub hanya menerima ID channel privat ini; tidak ada fallback nama/channel lain.
MOD_LOG_CHANNEL_ID=
RULES_CHANNEL_ID=
ROLES_CHANNEL_ID=
LEAVE_CHANNEL_ID=

# ── Role auto-assign pas member join (kosongin kalau belum ada) ──
MEMBER_ROLE_ID=

# ── AI (buat chat via mention) ──
# Groq: https://console.groq.com  |  OpenRouter: https://openrouter.ai
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Restricted document translation (DeepL) ──
# Hanya server-side. Jangan pernah expose key ke client atau commit .env asli.
DEEPL_API_KEY=
# Discord user IDs dipisah koma. OWNER_ID selalu otomatis diizinkan.
TRANSLATE_ALLOWED_USER_IDS=
# Opsional: default timeout 180000 ms dan maksimum 3 job aktif+antre.
TRANSLATE_TIMEOUT_MS=180000
TRANSLATE_MAX_QUEUE=3

# ---------- COMMUNITY EVENT HUB ----------
# Opsional: override folder state event. Default memakai folder data/ project.
EVENT_DATA_DIR=
# Override folder inbox Event Hub (testing/local advanced only; default memakai data/)
# Canox menulis data/canox-event-inbox.json secara atomik.

# ---------- RUNTIME HEALTH ----------
# Opsional: override lokasi snapshot health. Default: data/runtime-health.json.
# File hanya berisi status operasional aman; jangan arahkan ke folder publik/web.
HENGS_RUNTIME_HEALTH_FILE=

# Shared local queue used by Hengs WA -> Discord recovery alerts.
# Empty uses HenryLabs/Hengs/.runtime/wa-recovery-alerts.
HENGS_ALERT_BRIDGE_DIR=
# Cloud systemd lock override. Empty keeps the local project lock.
HENGS_INSTANCE_LOCK_FILE=
# Set false on cloud until the remote Tailscale WA bridge is implemented.
HENGS_WA_RECOVERY_ALERTS_ENABLED=true

# ---------- INCIDENT REPORT HUB ----------
# Role reviewer dipisah koma. Kosong = hanya OWNER_ID yang dapat mereview laporan.
REPORT_MODERATOR_ROLE_IDS=
# Runtime selalu mengambil batas terkecil dari nilai ini, 8 MiB, dan limit Discord.
REPORT_EVIDENCE_MAX_BYTES=8388608
# Laporan resolved/dismissed dihapus setelah masa ini; dibatasi 1-365 hari.
REPORT_RETENTION_DAYS=30

# ---------- ANTI-RAID ----------
# Tidak ada external reputation feed yang dibundel; rules domain dikelola manual.
MODERATION_ROLE_IDS=
ANTI_RAID_MODE=active
# Gunakan bare host names dipisah koma, tanpa scheme, path, port, atau wildcard.
ANTI_RAID_BLOCKED_DOMAINS=
MODERATION_DATA_DIR=
