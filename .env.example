# ════════════════════════════════════════════════════════
#  Hengs Discord Bot (Henzzz) — contoh konfigurasi
#  Copy file ini jadi `.env`, lalu isi value-nya.
#  JANGAN PERNAH commit file .env asli ke Git!
# ════════════════════════════════════════════════════════

# ── Bot credentials (Discord Developer Portal) ──
# Bot -> Reset Token. JANGAN share; regenerate kalau bocor.
DISCORD_TOKEN=
# General Information -> Application ID
DISCORD_CLIENT_ID=
# Aktifkan Developer Mode -> klik-kanan server -> Copy Server ID
DISCORD_GUILD_ID=
# User ID owner Discord. Wajib untuk approval Ops Hub dan /admin restart.
OWNER_ID=
# Role Discord yang boleh membuat, melihat, mengedit, dan merevisi draft Ops Hub.
# Pisahkan beberapa role ID dengan koma. Publish/jadwal/discard tetap owner-only.
OPS_EDITOR_ROLE_IDS=

# ── Channel IDs (klik-kanan channel -> Copy Channel ID) ──
ANNOUNCE_CHANNEL_ID=
WELCOME_CHANNEL_ID=
GSA_CHANNEL_ID=
BOT_CHANNEL_ID=
# Ops Hub review channel privat. Sangat disarankan; fallback hanya ke nama persis
# `🎛️・bot-settings` / `bot-settings`, tidak pernah ke BOT_CHANNEL_ID.
BOT_SETTINGS_CHANNEL_ID=
RULES_CHANNEL_ID=
ROLES_CHANNEL_ID=
LEAVE_CHANNEL_ID=

# ── Role auto-assign pas member join (kosongin kalau belum ada) ──
MEMBER_ROLE_ID=

# ── AI (buat chat via mention) ──
# Groq: https://console.groq.com  |  OpenRouter: https://openrouter.ai
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Restricted document translation (DeepL) ──
# Hanya server-side. Jangan pernah expose key ke client atau commit .env asli.
DEEPL_API_KEY=
# Discord user IDs dipisah koma. OWNER_ID selalu otomatis diizinkan.
TRANSLATE_ALLOWED_USER_IDS=
# Opsional: default timeout 180000 ms dan maksimum 3 job aktif+antre.
TRANSLATE_TIMEOUT_MS=180000
TRANSLATE_MAX_QUEUE=3

# ---------- COMMUNITY EVENT HUB ----------
# Opsional: override folder state event. Default memakai folder data/ project.
EVENT_DATA_DIR=
# Override folder inbox Event Hub (testing/local advanced only; default memakai data/)
# Canox menulis data/canox-event-inbox.json secara atomik.
